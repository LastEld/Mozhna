# Copy to .env for Docker Compose. Supply your own strong values before startup.
MOZHNA_PASSWORD=
POSTGRES_PASSWORD=
# Optional readonly MCP; minimum 32 characters. Keep empty to disable.
MOZHNA_MCP_TOKEN=
# Optional model inference. Disabled until explicitly switched on by operator.
MOZHNA_ALLOW_PAID_INFERENCE=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
MOZHNA_DAILY_JOB_LIMIT=40
