  "components": {
    "schemas": {
      "AuthView": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserView"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "user",
          "csrf_token"
        ],
        "title": "AuthView"
      },
      "Calculation": {
        "properties": {
          "calculation_id": {
            "type": "string",
            "title": "Calculation Id"
          },
          "snapshot_hash": {
            "type": "string",
            "title": "Snapshot Hash"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "evaluated_at": {
            "type": "string",
            "title": "Evaluated At"
          },
          "horizon_days": {
            "type": "integer",
            "title": "Horizon Days"
          },
          "horizon_end": {
            "type": "string",
            "title": "Horizon End"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "basis": {
            "type": "string",
            "title": "Basis"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assumptions"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "missing_inputs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Inputs"
          },
          "planned_limit_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned Limit Minor"
          },
          "essential_limit_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Essential Limit Minor"
          },
          "essential_headroom_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Essential Headroom Minor"
          },
          "planned_headroom_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned Headroom Minor"
          },
          "decision": {
            "type": "string",
            "enum": [
              "CAN",
              "CAN_WITH_TRADEOFF",
              "CANNOT",
              "UNKNOWN"
            ],
            "title": "Decision"
          },
          "candidate_minor": {
            "type": "integer",
            "title": "Candidate Minor"
          },
          "candidate_date": {
            "type": "string",
            "title": "Candidate Date"
          },
          "affected_commitments": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Affected Commitments"
          },
          "commitments_beyond_horizon": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Commitments Beyond Horizon"
          },
          "excluded_income_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Excluded Income Ids"
          },
          "explanation_factors": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Explanation Factors"
          }
        },
        "type": "object",
        "required": [
          "calculation_id",
          "snapshot_hash",
          "policy_version",
          "as_of",
          "evaluated_at",
          "horizon_days",
          "horizon_end",
          "currency",
          "basis",
          "assumptions",
          "warnings",
          "missing_inputs",
          "planned_limit_minor",
          "essential_limit_minor",
          "essential_headroom_minor",
          "planned_headroom_minor",
          "decision",
          "candidate_minor",
          "candidate_date",
          "affected_commitments",
          "commitments_beyond_horizon",
          "excluded_income_ids",
          "explanation_factors"
        ],
        "title": "Calculation"
      },
      "Commitment": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Label"
          },
          "amount_minor": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Amount Minor"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "title": "Due Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "amount_minor",
          "due_date"
        ],
        "title": "Commitment"
      },
      "Erase": {
        "properties": {
          "confirmation": {
            "type": "string",
            "const": "DELETE",
            "title": "Confirmation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmation"
        ],
        "title": "Erase"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportRequest": {
        "properties": {
          "csv_text": {
            "type": "string",
            "maxLength": 2000000,
            "minLength": 1,
            "title": "Csv Text"
          },
          "currency": {
            "type": "string",
            "const": "EUR",
            "title": "Currency",
            "default": "EUR"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "csv_text"
        ],
        "title": "ImportRequest"
      },
      "Income": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Label"
          },
          "amount_minor": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Amount Minor"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "title": "Due Date"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "amount_minor",
          "due_date"
        ],
        "title": "Income"
      },
      "JobCreate": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "compare_plan",
              "income_search",
              "draft_application"
            ],
            "title": "Kind"
